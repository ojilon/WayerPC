# Wails / Go outputs
build/bin/
build/windows/info.json
build/windows/wails.exe.manifest
bin/
out/
*.exe

# Vite / pnpm (see also frontend/.gitignore for dist/ + node_modules)
frontend/node_modules/
frontend/.pnpm-store/
node_modules/
.pnpm-store/

# .data dev stub: only README + .gitkeep files are tracked.
# Real databases and dev uploads stay local.
.data/wayerpc.db*
.data/Data/*.db*
.data/Data/*.db-journal
.data/shared/*
!.data/shared/.gitkeep
.data/received/*
!.data/received/.gitkeep
.data/Data/*
!.data/Data/.gitkeep

# --- Legacy Python/C++ (kept for reference under legacy/) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env/

# Native leftovers
*.o
*.obj
*.so
*.dll
*.dylib
*.exp
*.lib
*.pdb

# Ignore generated specs in the repo root only (legacy packaging spec is tracked)
/WayerPC.spec

# SQLite amalgamation (legacy; download locally — see legacy/backend/third_party/sqlite/README.md)
legacy/backend/third_party/sqlite/sqlite3.c
legacy/backend/third_party/sqlite/sqlite3.h
legacy/backend/third_party/sqlite/sqlite3ext.h

# App / editor
logs/
*.log
Thumbs.db
Desktop.ini
